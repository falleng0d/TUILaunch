<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.atm1020.tuilaunch</id>
    <name>TUILaunch</name>
    <vendor>atm1020</vendor>

    <depends>com.intellij.modules.platform</depends>
    <!-- com.intellij.modules.lang owns the inline.completion.provider extension point; the platform
         module alone does not declare it. -->
    <depends>com.intellij.modules.lang</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.atm1020.tuilaunch.services.TuiLauncherSettings"/>
        <applicationService
                serviceImplementation="com.github.atm1020.tuilaunch.copilot.CopilotLanguageServerService"/>
        <applicationConfigurable parentId="tools" instance="com.github.atm1020.tuilaunch.ui.TuiLauncherConfiguration"
                                 id="com.example.tuilauncher.TuiLauncherConfigurable"
                                 displayName="TUI Launcher"/>
        <notificationGroup id="TUILaunch" displayType="BALLOON"/>
        <!-- order="first": InlineCompletionHandler.getProvider serves an event with the first provider in
             loading order whose isEnabled says yes, and AI Assistant's own provider registers as
             "first, before ...Copilot...", so anything later never sees a prompt box event. Returning
             false here is what hands the event on to AI Assistant. -->
        <inline.completion.provider
                id="com.github.atm1020.tuilaunch.CopilotInlineCompletionProvider"
                implementation="com.github.atm1020.tuilaunch.copilot.CopilotInlineCompletionProvider"
                order="first"/>
        <postStartupActivity implementation="com.github.atm1020.tuilaunch.LoadDynamicActions"/>
        <!-- editorFactoryListener rather than lineMarkerProvider: MarkdownLanguage and PlainTextLanguage are
             siblings, so a lineMarkerProvider registered on "TEXT" never fires for a .md file, and registering
             on Language.ANY would hand us a PsiElement we cannot type without the Markdown plugin (TSK-9057). -->
        <editorFactoryListener implementation="com.github.atm1020.tuilaunch.prompt.PromptGutterInstaller"/>
        <!-- editorReleased is the only hook that still sees the prompt box user data on a box editor the
             platform is tearing down, which is where the Copilot virtual document has to be closed. -->
        <editorFactoryListener
                implementation="com.github.atm1020.tuilaunch.copilot.PromptBoxCopilotEditorListener"/>
        <!-- canCloseContents: without it the shared tab context menu's Close Tab / Close Other Tabs /
             Close All Tabs stay disabled and no X appears on a tab, no matter what
             Content.isCloseable says (TSK-9016). -->
        <!-- anchor only applies to a project whose workspace.xml has no window_info entry for TUILaunch yet.
             An existing project keeps its recorded anchor, and Restore Default Layout does not reset it
             either, so changing this only shows up in new projects (TSK-9063). -->
        <toolWindow id="TUILaunch"
                    anchor="right"
                    canCloseContents="true"
                    icon="org.jetbrains.plugins.terminal.TerminalIcons.OpenTerminal_13x13"
                    factoryClass="com.github.atm1020.tuilaunch.toolwindow.TuiLaunchToolWindowFactory"/>
    </extensions>

    <applicationListeners>
        <!-- projectClosing rather than a Disposable parented to the tool window content: the content
             manager is torn down after the project services, so LineStatusTrackerManager reports the
             prompt box editor as still held on dispose (TSK-9081). -->
        <listener class="com.github.atm1020.tuilaunch.services.ReleasePromptBoxEditorsOnProjectClose"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
    </applicationListeners>

    <actions>
        <action id="TUILauncher.FocusTui"
                class="com.github.atm1020.tuilaunch.action.FocusTuiAction"
                text="TUILaunch Focus"
                description="Move keyboard focus to the active TUI session">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="TUILauncher.FocusEditor"
                class="com.github.atm1020.tuilaunch.action.FocusEditorAction"
                text="TUILaunch Focus Editor"
                description="Move keyboard focus back to the editor">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="TUILauncher.ToggleFocus"
                class="com.github.atm1020.tuilaunch.action.ToggleFocusAction"
                text="TUILaunch Toggle Focus"
                description="Toggle focus between the TUI session and the editor">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="TUILauncher.ToggleToolWindow"
                class="com.github.atm1020.tuilaunch.action.ToggleToolWindowAction"
                text="TUILaunch Toggle Tool Window"
                description="Show or hide the TUILaunch tool window">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="TUILauncher.ToggleToolWindowAndFocus"
                class="com.github.atm1020.tuilaunch.action.ToggleToolWindowAndFocusAction"
                text="TUILaunch Toggle Tool Window and Focus"
                description="Show and focus, or hide, the TUILaunch tool window">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="TUILauncher.CloseActiveTui"
                class="com.github.atm1020.tuilaunch.action.CloseActiveTuiAction"
                text="TUILaunch Close Active TUI"
                description="Close the currently selected TUI session tab">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="TUILauncher.NextTuiTab"
                class="com.github.atm1020.tuilaunch.action.NextTuiTabAction"
                text="TUILaunch Next TUI Tab"
                description="Move focus to the next open TUI session tab">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="TUILauncher.NextTuiTabWithoutFocus"
                class="com.github.atm1020.tuilaunch.action.NextTuiTabWithoutFocusAction"
                text="TUILaunch Next TUI Tab Without Focus"
                description="Move to the next open TUI session tab without requesting terminal focus">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="TUILauncher.PreviousTuiTab"
                class="com.github.atm1020.tuilaunch.action.PreviousTuiTabAction"
                text="TUILaunch Previous TUI Tab"
                description="Move focus to the previous open TUI session tab">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="TUILauncher.PreviousTuiTabWithoutFocus"
                class="com.github.atm1020.tuilaunch.action.PreviousTuiTabWithoutFocusAction"
                text="TUILaunch Previous TUI Tab Without Focus"
                description="Move to the previous open TUI session tab without requesting terminal focus">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <!-- No <keyboard-shortcut>: a default keystroke here would silently shadow whatever the
             IDE keymap already binds it to, so the user assigns one in Settings | Keymap. -->
        <action id="TUILauncher.FocusPromptBox"
                class="com.github.atm1020.tuilaunch.action.FocusPromptBoxAction"
                text="TUILaunch Toggle Prompt Box Focus"
                description="Move keyboard focus into the prompt box of the active TUI session, showing it first when it is hidden, and hide it again when it already holds the focus">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="TUILauncher.SendPromptBlock"
                class="com.github.atm1020.tuilaunch.action.SendPromptBlockUnderCaretAction"
                text="TUILaunch Send Prompt Block"
                description="Send the PROMPT.md prompt block under the cursor to the active TUI session">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <!-- The one action here that ships with a default keystroke, because the prompt box needs a
             send key the way any chat input does. control ENTER is already bound in $default to
             EditorSplitLine, ViewSource, SplitChooser.Duplicate, Console.Execute.Multiline and
             DirDiffMenu.SynchronizeDiff.All. Sharing it is safe: IdeKeyEventDispatcher collects the
             actions registered on the focused component chain before the keymap ones and runs the
             first *enabled* one, and update() enables this action only when the data context carries
             a prompt box, so everywhere else the IDE's own binding still wins. That is the scheme
             the platform's own Console.Execute.Multiline uses for the same keystroke. The macOS
             keymaps get Cmd+Return instead, which is what Mac chat inputs use and is unbound in
             every shipped keymap; a keymap that declares its own shortcuts for an action id does not
             inherit the parent keymap's for that id, so they end up with Cmd+Return only. -->
        <action id="TUILauncher.SendPromptBox"
                class="com.github.atm1020.tuilaunch.action.SendPromptBoxAction"
                text="TUILaunch Send Prompt Box"
                description="Send the prompt typed in the prompt box to its TUI session">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control ENTER"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta ENTER"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta ENTER"/>
        </action>
        <!-- No <keyboard-shortcut> and no group: browsing the prompt box history means nothing outside a
             prompt box, so these two are registered per box on its panel with a composite of whatever the
             keymap binds them to and EditorUp / EditorDown's own shortcut sets. Up and Down on the box's
             first and last line therefore browse the history while the caret still moves everywhere else,
             and both actions still show up in Settings | Keymap for anyone who wants another binding. -->
        <action id="TUILauncher.PromptHistoryPrevious"
                class="com.github.atm1020.tuilaunch.action.PromptHistoryPreviousAction"
                text="TUILaunch Previous Prompt in History"
                description="Show the previous prompt from PROMPT.md in the prompt box"/>
        <action id="TUILauncher.PromptHistoryNext"
                class="com.github.atm1020.tuilaunch.action.PromptHistoryNextAction"
                text="TUILaunch Next Prompt in History"
                description="Show the next prompt from PROMPT.md in the prompt box"/>
        <!-- Not added to any menu group: looked up by id from TuiLaunchToolWindowFactory.init and
             installed as the tool window tab bar's "+" button (TSK-9013). -->
        <action id="TUILaunch.NewSession"
                class="com.github.atm1020.tuilaunch.action.TuiNewSessionAction"
                text="New Session"
                description="Start a new TUI session"/>
        <!-- Not added to any menu group: looked up by id from
             TuiLaunchToolWindowFactory.createToolWindowContent and installed as a tool window title bar
             button, left of the gear (TSK-9059). -->
        <action id="TUILaunch.OpenPromptFile"
                class="com.github.atm1020.tuilaunch.action.OpenPromptFileAction"
                text="Open Prompt File"
                description="Open this project's PROMPT.md, creating it if it does not exist yet"/>
        <!-- Not added to any menu group: looked up by id from
             TuiLaunchToolWindowFactory.createToolWindowContent and installed as the first tool window
             title bar button, left of "Open Prompt File". -->
        <action id="TUILaunch.TogglePromptBox"
                class="com.github.atm1020.tuilaunch.action.TogglePromptBoxAction"
                text="Toggle Prompt Box"
                description="Show or hide the prompt box under the active TUI session"/>
        <action id="TUILaunch.RenameSession"
                class="com.github.atm1020.tuilaunch.action.TuiRenameSessionAction"
                text="Rename Session"
                description="Rename this TUI session's tab">
            <add-to-group group-id="ToolWindowContextMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
